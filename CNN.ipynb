   "source": [
    "# MNIST Handwritten Digit Classification using Perceptron & CNN\n",
    "\n",
    "This notebook demonstrates building and comparing two neural network architectures for classifying handwritten digits from the MNIST dataset:\n",
    "1. **Single-layer Perceptron (Dense model)**\n",
    "2. **Convolutional Neural Network (CNN)**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "from sklearn.preprocessing import LabelEncoder , StandardScaler\n",
    "from sklearn.model_selection import train_test_split\n",
    "\n",
    "from sklearn.linear_model import Perceptron    # Used for simple linear classification tasks.\n",
    "\n",
    "from sklearn.metrics import accuracy_score, classification_report, confusion_matrix\n",
    "\n",
    "from tensorflow.keras.models import Sequential     # Sequential lets you build a neural network layer-by-layer in Keras.\n",
    "\n",
    "from tensorflow.keras.layers import Dense     # Dense makes the final predictions\n",
    "from tensorflow.keras.layers import Conv2D     # Conv2D extracts features\n",
    "from tensorflow.keras.layers import Flatten    # Flatten reshapes them\n",
    "\n",
    "from tensorflow.keras.layers import MaxPooling2D     # MaxPooling2D reduces size\n",
    "from tensorflow.keras.layers import Dropout          # Dropout prevents overfitting\n",
    "\n",
    "from tensorflow.keras.utils import to_categorical     # converts numeric class labels into one-hot encoded format"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df = pd.read_csv(\"/content/sample_data/mnist_train_small.csv\", header=None)\n",
    "df_test = pd.read_csv(\"/content/sample_data/mnist_test.csv\", header=None)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df.columns"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df.info()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df.shape"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df.isnull().sum()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Preprocess the data\n",
    "# Column 0 contains the labels, columns 1-784 contain the pixel features.\n",
    "X_train = df.drop(0, axis=1).values # Drop column 0 (labels) to get features\n",
    "y_train = df[0].values             # Select column 0 to get labels\n",
    "X_test = df_test.drop(0, axis=1).values # Do the same for the test set\n",
    "y_test = df_test[0].values\n",
    "\n",
    "# Scale pixel values to [0, 1]\n",
    "X_train = X_train.astype(\"float32\") / 255.0\n",
    "X_test = X_test.astype(\"float32\") / 255.0\n",
    "\n",
    "X_train_img = X_train.reshape(-1, 28, 28)\n",
    "X_test_img = X_test.reshape(-1, 28, 28)\n",
    "\n",
    "# One-hot encoding\n",
    "y_train_cat = to_categorical(y_train, 10)\n",
    "y_test_cat = to_categorical(y_test, 10)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "perceptron = Sequential([\n",
    "    Flatten(input_shape=(28,28)),\n",
    "    Dense(10, activation=\"softmax\")\n",
    "])\n",
    "\n",
    "perceptron.compile(optimizer=\"sgd\", loss=\"categorical_crossentropy\", metrics=[\"accuracy\"])\n",
    "\n",
    "history_percp = perceptron.fit(X_train_img, y_train_cat, epochs=5, batch_size=32, validation_data=(X_test_img, y_test_cat), verbose=1)\n",
    "\n",
    "acc_percp = perceptron.evaluate(X_test_img, y_test_cat, verbose=0)[1]\n",
    "print(\"Perceptron Accuracy:\", acc_percp)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "X_train_cnn = X_train.reshape(-1, 28, 28, 1)\n",
    "X_test_cnn = X_test.reshape(-1, 28, 28, 1)\n",
    "\n",
    "cnn = Sequential([\n",
    "    Conv2D(32, kernel_size=(3,3), activation=\"relu\", input_shape=(28,28,1)),\n",
    "    MaxPooling2D(pool_size=(2,2)),\n",
    "    Conv2D(64, kernel_size=(3,3), activation="relu"),\n",
    "    MaxPooling2D(pool_size=(2,2)),\n",
    "    Flatten(),\n",
    "    Dense(128, activation=\"relu\"),\n",
    "    Dropout(0.5),\n",
    "    Dense(10, activation=\"softmax\")\n",
    "])\n",
    "\n",
    "cnn.compile(optimizer=\"adam\", loss=\"categorical_crossentropy\", metrics=[\"accuracy\"])\n",
    "\n",
    "history_cnn = cnn.fit(X_train_cnn, y_train_cat, epochs=5, batch_size=32, validation_data=(X_test_cnn, y_test_cat), verbose=1)\n",
    "\n",
    "acc_cnn = cnn.evaluate(X_test_cnn, y_test_cat, verbose=0)[1]\n",
    "print(\"CNN Accuracy:\", acc_cnn)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Perceptron Model Training History"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.figure(figsize=(12, 5))\n",
    "\n",
    "# Plot training & validation accuracy values\n",
    "plt.subplot(1, 2, 1)\n",
    "plt.plot(history_percp.history['accuracy'])\n",
    "plt.plot(history_percp.history['val_accuracy'])\n",
    "plt.title('Perceptron Model Accuracy')\n",
    "plt.ylabel('Accuracy')\n",
    "plt.xlabel('Epoch')\n",
    "plt.legend(['Train', 'Validation'], loc='upper left')\n",
    "\n",
    "# Plot training & validation loss values\n",
    "plt.subplot(1, 2, 2)\n",
    "plt.plot(history_percp.history['loss'])\n",
    "plt.plot(history_percp.history['val_loss'])\n",
    "plt.title('Perceptron Model Loss')\n",
    "plt.ylabel('Loss')\n",
    "plt.xlabel('Epoch')\n",
    "plt.legend(['Train', 'Validation'], loc='upper left')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
